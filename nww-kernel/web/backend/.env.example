# NWW-V14 内核启动环境变量样例
#
# 说明：start.sh 不加载 .env 文件（与 V12 原脚本一致），默认值全部内联在 start.sh
# 中。本文件仅作为文档与手动覆盖参考，例如：
#   set -a; . ./env.local; set +a; ./start.sh

# 监听地址与端口（V12 生产 8010，V14 内核固定 8210）
PORT=8210
HOST=127.0.0.1

# 书库根：相对 web/backend/ 上两级即 <V14>/nww-kernel/projects
NWW_PROJECTS_ROOT=../projects
# 本地单用户身份（同时决定书库子目录 projects/<值>/）
NWW_LOCAL_SINGLE_USER=v14-local
# 运行态模型配置（无真实密钥）
NWW_MODEL_CONFIG_FILE=../runtime/config/model_config.json

# V14 不跑 MCP（mcp 包未纳入依赖）
NWW_MCP_ENABLED=0
NWW_DATA_PLANE=1
NWW_MVP_ENABLED=1
NWW_SUPERVISOR_ENABLED=1